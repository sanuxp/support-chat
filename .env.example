# Copy to .env (scripts/init.sh does this for you). Dummy values below are for local dev only.
# Values left EMPTY marked "auto" are generated by scripts/init.sh (random 32-byte hex).

MATRIX_SERVER_NAME=chat.local
MATRIX_PUBLIC_BASEURL=http://localhost:8008
AS_TOKEN=                        # auto
HS_TOKEN=                        # auto
SYNAPSE_REGISTRATION_SHARED_SECRET=   # auto
POSTGRES_PASSWORD=               # auto
BACKEND_PORT=3000
APPSERVICE_PORT=9000
BACKEND_JWT_SECRET=              # auto; signs customer session tokens for backend REST
ADMIN_API_TOKEN=                 # auto; protects POST /api/admin/reload-config
CUSTOMER_AUTH_MODE=anonymous     # anonymous | external_jwt
# only used if CUSTOMER_AUTH_MODE=external_jwt (dummy placeholder, not a real key)
EXTERNAL_JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\nDUMMY-REPLACE-ME\n-----END PUBLIC KEY-----"

# OpenAI-compatible endpoint, e.g. a LiteLLM proxy (https://host or https://host/v1)
LLM_BASE_URL=https://litellm.example.com
LLM_API_KEY=sk-dummy-replace-with-your-litellm-key
LLM_MODEL=gpt-4.1-mini

AI_HISTORY_MESSAGES=30
AI_STREAM_EDIT_INTERVAL_MS=1000
ENABLE_E2EE=false                # hook for later, must stay false in v1
TOOLS_CONFIG_PATH=./config/tools.yaml
PROMPTS_DIR=./config/prompts
COMPANY_NAME=Acme Support

# Used when the host web page does not send the customer's details (see README: "Passing user details")
DEFAULT_CUSTOMER_NAME=Test User
DEFAULT_CUSTOMER_EMAIL=testuser@test.com
DEFAULT_CUSTOMER_PHONE=+9876543210

# --- Email (used by the escalate_via_email tool) -----------------------------------------------
# Default: local fake SMTP (Mailpit). Inbox: http://localhost:8025
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_SECURE=false                # true = implicit TLS (port 465). With a user set, STARTTLS is required.
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=support@chat.local
# Where escalation emails are sent
SUPPORT_EMAIL_TO=support@example.com
#
# Gmail instead (needs 2-Step Verification + an App Password: https://myaccount.google.com/apppasswords):
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_SECURE=false
#   SMTP_USER=yourname@gmail.com
#   SMTP_PASSWORD=<16-character app password, not your normal password>
#   SMTP_FROM=yourname@gmail.com     # Gmail rewrites From to the authenticated account

WEBHOOK_SIGNING_SECRET=          # auto; HMAC secret for outgoing webhook calls
# Used by the optional create_ticket example tool in config/tools.yaml
TICKETS_API_TOKEN=dummy-tickets-token
